{
  "name": "@bullmq-dash/api",
  "version": "1.0.0",
  "description": "Framework-free core of the bullmq-dash dashboard — drop-in mirror of @bull-board/api",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiqryamir/bullmq-dash.git",
    "directory": "packages/api"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "@bullmq-dash/ui": "^1.0.0-alpha.1",
    "bullmq": ">=5.79.2 <7"
  },
  "peerDependenciesMeta": {
    "@bullmq-dash/ui": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bullmq-dash/ui": "workspace:*",
    "@types/node": "^20.19.43",
    "@types/redis-info": "^3.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "bullmq": "^6.1.0",
    "ioredis": "^5.11.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "redis-info": "^3.1.0"
  }
}
