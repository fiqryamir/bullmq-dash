{
  "name": "bullmq-dash",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./website\" run typecheck",
    "build": "pnpm --filter \"./packages/*\" --filter \"./website\" run build",
    "release": "pnpm run build && pnpm changeset publish"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.40.0"
  }
}
